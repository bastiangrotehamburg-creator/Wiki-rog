# ---------------------------------------------------------------------------
# BookStack REST-API (externes Wiki)
# API-Token erstellen: BookStack -> Profil bearbeiten -> API-Tokens
# ---------------------------------------------------------------------------
BOOKSTACK_URL=https://wiki.example.com
BOOKSTACK_TOKEN_ID=dein_token_id
BOOKSTACK_TOKEN_SECRET=dein_token_secret
# Nur diese Buch-/Shelf-IDs indexieren (kommagetrennt). Leer = alles.
BOOKSTACK_BOOK_IDS=
BOOKSTACK_SHELF_IDS=
# TLS-Prüfung des externen Wikis. Bei privater/interner CA lieber die CA über
# SSL_CERT_FILE einbinden statt hier auf false zu setzen.
BOOKSTACK_VERIFY_SSL=true
# Optional: Pfad zu einer eigenen CA-Bundle-Datei (Go liest SSL_CERT_FILE)
# SSL_CERT_FILE=/certs/ca.crt

# ---------------------------------------------------------------------------
# Ollama (lokal) – https://ollama.com
# Kleines, CPU-taugliches Modell (kein GPU nötig):
#   ollama pull llama3.2:1b
#   ollama pull nomic-embed-text
# Alternativen: qwen2.5:1.5b, gemma2:2b, llama3.2:3b (etwas größer)
# ---------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Vektorspeicher
#   local  = eingebettet, pure Go (File + In-Memory-Cosine-Suche)  [Standard]
#   qdrant = externer Qdrant-Dienst über HTTP
# ---------------------------------------------------------------------------
VECTOR_BACKEND=local
VECTOR_COLLECTION=bookstack
# Backend "local": Verzeichnis der Speicherdatei
STORE_DIR=./data/store
# Backend "qdrant":
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Chunking / Retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Cosine-Distanz-Schwelle (0-2). Treffer darüber gelten als irrelevant.
RETRIEVAL_MAX_DISTANCE=1.0

# ---------------------------------------------------------------------------
# Web-Server (Befehl: wiki-rog serve)
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080

# ---------------------------------------------------------------------------
# Zugriff / Login (gruppenbasiert). Ist die Access-Datei nicht vorhanden,
# läuft die WebUI OFFEN (kein Login, eine Collection = VECTOR_COLLECTION).
#   Passwort-Hash erzeugen:  wiki-rog hashpw
# ---------------------------------------------------------------------------
ACCESS_CONFIG=./config/access.json
# Secret zum Signieren der Session-Cookies (unbedingt setzen für stabile Sessions)
SESSION_SECRET=
SESSION_TTL_HOURS=12
# true, wenn hinter HTTPS (setzt das Secure-Flag am Cookie)
SESSION_SECURE=false
