# ---------------------------------------------------------------------------
# BookStack REST-API
# API-Token erstellen: BookStack -> Profil bearbeiten -> API-Tokens
# ---------------------------------------------------------------------------
BOOKSTACK_URL=https://wiki.example.com
BOOKSTACK_TOKEN_ID=dein_token_id
BOOKSTACK_TOKEN_SECRET=dein_token_secret
# Nur diese Buch-/Shelf-IDs indexieren (kommagetrennt). Leer = alles.
BOOKSTACK_BOOK_IDS=
BOOKSTACK_SHELF_IDS=

# ---------------------------------------------------------------------------
# Ollama (lokal) – https://ollama.com
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
# ---------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Vektorspeicher / Chunking / Retrieval
# ---------------------------------------------------------------------------
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=bookstack
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Distanz-Schwelle (0-2, cosine). Chunks darüber gelten als irrelevant.
RETRIEVAL_MAX_DISTANCE=1.0
